<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('partials/head', { title: 'Your Goals. Our Tracker. Better You.', app: false }) %>
</head>
<body>
  <a class="skip-link" href="#main">Skip to content</a>

  <header class="site-header">
    <div class="container header-inner">
      <a href="/" class="brand">
        <div class="brand-mark" aria-hidden="true">S</div>
        <div>
          <div class="brand-name">Skill<span>Sprint</span></div>
          <div class="brand-tag">Smart Student Progress Tracker</div>
        </div>
      </a>

      <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="site-nav">
        <span aria-hidden="true">☰</span><span class="sr-only">Menu</span>
      </button>

      <nav class="site-nav" id="site-nav" aria-label="Main">
        <a href="#features" class="link">Features</a>
        <a href="#about" class="link">About</a>
        <a href="/login" class="btn btn-outline">Log in</a>
        <a href="/signup" class="btn btn-primary">Create free account</a>
      </nav>
    </div>
  </header>

  <div class="container">

    <main id="main">

      <section class="hero">
        <div class="reveal reveal-1">
          <div class="hero-eyebrow">Plan · Study · Achieve</div>
          <h1>
            <span class="g1">Your Goals.</span><br>
            <span class="g2">Our Tracker.</span><br>
            <span class="g3">Better You.</span>
          </h1>
          <p class="lede">
            Attendance, CGPA, lecture notes and your batch group — in one place,
            built around how Indian engineering colleges actually work.
          </p>
          <div class="hero-cta">
            <a href="/signup" class="btn btn-primary">Start tracking free</a>
            <a href="/login" class="btn btn-outline">I already have an account</a>
          </div>

          <dl class="hero-stats">
            <div><b>75%</b><span>Attendance rule, checked for you</span></div>
            <div><b>10.0</b><span>CGPA scale, semester by semester</span></div>
            <div><b>5</b><span>Tools, one login</span></div>
          </dl>
        </div>

        <aside class="hero-preview demo reveal reveal-2" aria-label="Interactive attendance example">
          <div class="demo-head">
            <span class="demo-title">Try it: Data Structures</span>
            <span class="demo-chip">Live example</span>
          </div>

          <div class="demo-figure">
            <div class="demo-pct" id="demoPct">82%</div>
            <div class="demo-count"><span id="demoAttended">18</span> of <span id="demoTotal">22</span> lectures attended</div>
          </div>

          <div class="demo-bar" role="img" aria-label="Attendance compared with the 75 percent rule">
            <i id="demoFill" style="width:82%;"></i>
            <span class="demo-mark" style="left:75%;"><em>75%</em></span>
          </div>

          <p class="demo-msg" id="demoMsg" aria-live="polite"></p>

          <div class="demo-actions">
            <button type="button" class="demo-btn demo-present" id="demoPresent">Mark present</button>
            <button type="button" class="demo-btn demo-absent" id="demoAbsent">Mark absent</button>
          </div>

          <div class="demo-foot">
            <span>Press the buttons. The real Attendance page works the same way for every subject.</span>
            <button type="button" class="demo-reset" id="demoReset">Start over</button>
          </div>
        </aside>
      </section>

      <section id="features" class="feature-grid" aria-label="What SkillSprint does">
        <article class="feature-card reveal-on-scroll">
          <div class="feature-icon-tile" style="background:rgba(139,92,246,.12);" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="#8b5cf6" stroke-width="1.5"><rect x="3" y="5" width="18" height="16" rx="2"/><path d="M16 3v4M8 3v4M3 10h18"/><path d="M8.5 15l2 2 4-4"/></svg>
          </div>
          <h4>Attendance</h4>
          <p>Mark each lecture and see straight away whether you're above 75%.</p>
        </article>

        <article class="feature-card reveal-on-scroll">
          <div class="feature-icon-tile" style="background:rgba(59,130,246,.12);" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="#3b82f6" stroke-width="1.5"><rect x="4" y="3" width="16" height="18" rx="2"/><path d="M8 7h8M8 11h2M12 11h2M8 15h2M12 15h2"/></svg>
          </div>
          <h4>CGPA calculator</h4>
          <p>Enter marks per semester, get your SGPA and running CGPA.</p>
        </article>

        <article class="feature-card reveal-on-scroll">
          <div class="feature-icon-tile" style="background:rgba(34,211,238,.12);" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="#22d3ee" stroke-width="1.5"><path d="M4 4h13a2 2 0 0 1 2 2v14H6a2 2 0 0 1-2-2V4z"/><path d="M4 4v16M8 8h7M8 12h7M8 16h4"/></svg>
          </div>
          <h4>Lecture notes</h4>
          <p>Write notes per subject while the class is still fresh.</p>
        </article>

        <article class="feature-card reveal-on-scroll">
          <div class="feature-icon-tile" style="background:rgba(236,72,153,.12);" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="#ec4899" stroke-width="1.5"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/></svg>
          </div>
          <h4>Batch community</h4>
          <p>You're put in a group with your own college, year and stream.</p>
        </article>

        <article class="feature-card reveal-on-scroll">
          <div class="feature-icon-tile" style="background:rgba(245,158,11,.12);" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="#f59e0b" stroke-width="1.5"><path d="M18 8a6 6 0 0 0-12 0c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.73 21a2 2 0 0 1-3.46 0"/></svg>
          </div>
          <h4>Reminders</h4>
          <p>Assignments stay pinned to the subject until you clear them.</p>
        </article>
      </section>

      <section id="about" class="stats-band icon-banner reveal-on-scroll">
        <div class="band-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1"><path d="M22 10L12 5 2 10l10 5 10-5z"/><path d="M6 12v5c0 1.5 3 3 6 3s6-1.5 6-3v-5"/><path d="M22 10v6"/></svg>
        </div>
        <div class="stats-band-content">
          <div><b>800+</b><span>Colleges under University of Mumbai alone</span></div>
          <div><b>10.0</b><span>Point CGPA scale, fully calculated</span></div>
          <div><b>75%</b><span>The rule every student tracks, now automatic</span></div>
        </div>
      </section>

      <p class="slogan-strip reveal-on-scroll">"<b>Small steps every day</b> lead to big results."</p>

    </main>

    <footer class="site-footer">
      <div>© <%= new Date().getFullYear() %> SkillSprint — made for students.</div>
      <nav aria-label="Footer">
        <a href="#features">Features</a>
        <a href="#about">About</a>
        <a href="/login">Log in</a>
        <a href="/signup">Create account</a>
      </nav>
    </footer>

  </div>

  <script src="/js/main.js"></script>
  <script src="/js/upgrade.js"></script>
  <script>
    // Live attendance example in the hero. Same maths the Attendance page uses:
    // percentage = attended / total, and the 75% rule decides what to tell you.
    (function () {
      var START_A = 18, START_T = 22;
      var a = START_A, t = START_T;
      var pctEl = document.getElementById('demoPct');
      var attEl = document.getElementById('demoAttended');
      var totEl = document.getElementById('demoTotal');
      var fillEl = document.getElementById('demoFill');
      var msgEl = document.getElementById('demoMsg');
      if (!pctEl || !fillEl || !msgEl) return;

      function render() {
        var pct = t ? (a / t) * 100 : 0;
        var ok = pct >= 75;
        pctEl.textContent = Math.round(pct) + '%';
        pctEl.className = 'demo-pct ' + (ok ? 'is-ok' : 'is-low');
        attEl.textContent = a;
        totEl.textContent = t;
        fillEl.style.width = Math.min(100, pct) + '%';
        fillEl.className = ok ? '' : 'is-low';

        if (ok) {
          var spare = Math.floor((4 * a) / 3 - t + 1e-9);
          msgEl.textContent = spare > 0
            ? 'Safe. You can miss ' + spare + ' more lecture' + (spare === 1 ? '' : 's') + ' and still stay above 75%.'
            : 'Right on the line. Miss one more and you drop below 75%.';
        } else {
          var need = 3 * t - 4 * a;
          msgEl.textContent = 'Below 75%. Attend the next ' + need + ' lecture' + (need === 1 ? '' : 's') + ' in a row to get back to safe.';
        }
      }

      document.getElementById('demoPresent').addEventListener('click', function () { a += 1; t += 1; render(); });
      document.getElementById('demoAbsent').addEventListener('click', function () { t += 1; render(); });
      document.getElementById('demoReset').addEventListener('click', function () { a = START_A; t = START_T; render(); });
      render();
    })();
  </script>
</body>
</html>
