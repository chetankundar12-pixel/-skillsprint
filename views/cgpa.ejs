<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>CGPA Calculator — SkillSprint</title>
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="/css/dashboard.css">
  <link rel="stylesheet" href="/css/upgrade.css">
</head>
<body>
  <div class="app-shell">
    <%- include('partials/sidebar', { active: 'cgpa', user }) %>

    <div class="main">
      <%- include('partials/topbar', { user }) %>

      <div class="dcontent">
        <div class="photo-banner reveal">
          <%- include('partials/banner-photo', { user }) %>
          <div class="banner-body">
            <h1>🧮 <span class="name-accent">CGPA Calculator</span></h1>
            <div class="banner-tagline"><span class="t1">Your grades.</span> <span class="t2">Your progress.</span></div>
            <p class="banner-desc">Enter your subject marks and credits to calculate your SGPA and CGPA instantly.</p>
          </div>
        </div>

        <div style="display:grid; grid-template-columns:1.6fr 1fr; gap:20px; align-items:start;">
          <div class="section-card">
            <div class="section-head">
              <h3>Enter Your Subjects</h3>
              <form method="get" action="/cgpa" style="display:flex; align-items:center; gap:8px;">
                <span class="hint-text">Semester</span>
                <select name="sem" class="field" style="padding:6px 10px; width:auto;" onchange="this.form.submit()">
                  <% for (let i = 1; i <= 8; i++) { %>
                    <option value="<%= i %>" <%= currentSem === i ? 'selected' : '' %>>Semester <%= i %></option>
                  <% } %>
                </select>
              </form>
            </div>

            <form method="post" action="/cgpa/save-semester">
              <input type="hidden" name="sem" value="<%= currentSem %>">
              <div style="display:grid; grid-template-columns:2fr 1fr 1fr auto; gap:10px; font-size:.72rem; color:var(--muted); text-transform:uppercase; letter-spacing:.03em; margin-bottom:8px;">
                <span>Subject Name</span><span>Credits</span><span>Marks /100</span><span></span>
              </div>
              <div id="subjectRows">
                <% const seedRows = subjects.length ? subjects : [{name:'',credits:'',marks:''}]; %>
                <% seedRows.forEach(s => { %>
                  <div class="marks-row" style="grid-template-columns:2fr 1fr 1fr auto;">
                    <input type="text" name="name" class="field" style="padding:9px 12px;" placeholder="Subject name" value="<%= s.name %>">
                    <input type="number" name="credits" min="1" max="10" class="field" style="padding:9px 12px;" placeholder="Credits" value="<%= s.credits %>">
                    <input type="number" name="marks" min="0" max="100" class="field" style="padding:9px 12px;" placeholder="Marks" value="<%= s.marks %>">
                    <button type="button" class="remove" onclick="this.closest('.marks-row').remove();">✕</button>
                  </div>
                <% }) %>
              </div>
              <button type="button" id="addSubjectRowBtn" class="btn btn-outline" style="margin-top:6px;">+ Add Subject</button>
              <button type="submit" class="btn btn-primary" style="margin-top:18px; width:100%;">🧮 Calculate CGPA</button>
            </form>
          </div>

          <div>
            <div class="section-card" style="text-align:center;">
              <% const gaugePct = Math.min(100, (overallCgpaVal / 10) * 100); const circ = 2 * Math.PI * 50; const gaugeDash = (gaugePct/100) * circ; %>
              <div class="ring-wrap" style="width:150px; height:150px; margin:0 auto;">
                <svg viewBox="0 0 120 120">
                  <circle cx="60" cy="60" r="50" fill="none" stroke="#232a4a" stroke-width="12"/>
                  <circle cx="60" cy="60" r="50" fill="none" stroke="url(#cgpaGrad)" stroke-width="12" stroke-linecap="round"
                    stroke-dasharray="<%= gaugeDash %> <%= circ %>"/>
                  <defs>
                    <linearGradient id="cgpaGrad" x1="0" y1="0" x2="1" y2="1">
                      <stop offset="0%" stop-color="#8b5cf6"/>
                      <stop offset="100%" stop-color="#22d3ee"/>
                    </linearGradient>
                  </defs>
                </svg>
                <div class="ring-label"><b style="font-size:1.6rem;"><%= overallCgpaVal %></b><span>CGPA</span></div>
              </div>
              <div style="display:flex; justify-content:space-around; margin-top:18px; font-size:.82rem;">
                <div><div style="font-weight:800; font-size:1.05rem;"><%= semStats.totalCredits %></div><div class="hint-text">Total Credits</div></div>
                <div><div style="font-weight:800; font-size:1.05rem;"><%= semStats.totalPoints %></div><div class="hint-text">Grade Points</div></div>
                <div><div style="font-weight:800; font-size:1.05rem;"><%= semStats.sgpa %></div><div class="hint-text">SGPA (Sem <%= currentSem %>)</div></div>
              </div>
              <% if (semStats.sgpa >= 8) { %>
                <div class="notice" style="margin-top:16px;">🎉 Great job! You're doing amazing. Keep it up!</div>
              <% } %>
            </div>

            <div class="section-card">
              <div class="section-head"><h3>Grade Scale</h3></div>
              <table class="grade-table">
                <thead><tr><th>Grade</th><th>Points</th><th>Marks Range</th></tr></thead>
                <tbody>
                  <% scale.forEach((s, i) => {
                    const nextMin = i > 0 ? scale[i-1].min - 1 : 100;
                  %>
                    <tr><td><%= s.grade %></td><td><%= s.points %></td><td><%= s.min %>–<%= nextMin %></td></tr>
                  <% }) %>
                </tbody>
              </table>
            </div>

            <div class="section-card">
              <div class="section-head"><h3>Quick CGPA Average</h3></div>
              <p class="hint-text" style="margin-bottom:12px;">Already know each semester's CGPA? Add as many as you've completed and get the straight average — separate from the detailed calculator above.</p>
              <div id="quickCgpaRows">
                <div class="marks-row" style="grid-template-columns:2fr 1fr auto;">
                  <input type="text" class="field" style="padding:9px 12px;" placeholder="Semester 1" data-role="qlabel" value="Semester 1">
                  <input type="number" min="0" max="10" step="0.01" class="field" style="padding:9px 12px;" placeholder="CGPA" data-role="qval">
                  <button type="button" class="remove" onclick="this.closest('.marks-row').remove(); recalcQuickAvg();">✕</button>
                </div>
              </div>
              <button type="button" id="addQuickRowBtn" class="btn btn-outline" style="margin-top:6px;">+ Add Semester</button>
              <div class="cgpa-result" style="margin-top:16px;">
                <div class="big" id="quickAvgResult">0</div>
                <div class="hint-text">Average across <span id="quickAvgCount">0</span> semester(s)</div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <script>
    function addQuickRow() {
      const wrap = document.getElementById('quickCgpaRows');
      const n = wrap.children.length + 1;
      const row = document.createElement('div');
      row.className = 'marks-row';
      row.style.gridTemplateColumns = '2fr 1fr auto';
      row.innerHTML = `
        <input type="text" class="field" style="padding:9px 12px;" placeholder="Semester ${n}" data-role="qlabel" value="Semester ${n}">
        <input type="number" min="0" max="10" step="0.01" class="field" style="padding:9px 12px;" placeholder="CGPA" data-role="qval">
        <button type="button" class="remove" onclick="this.closest('.marks-row').remove(); recalcQuickAvg();">✕</button>
      `;
      wrap.appendChild(row);
    }
    function recalcQuickAvg() {
      const vals = Array.from(document.querySelectorAll('#quickCgpaRows [data-role="qval"]'))
        .map(i => i.value).filter(v => v !== '').map(Number);
      const avg = vals.length ? (vals.reduce((a,b)=>a+b,0) / vals.length) : 0;
      document.getElementById('quickAvgResult').textContent = Math.round(avg * 100) / 100;
      document.getElementById('quickAvgCount').textContent = vals.length;
    }
    document.getElementById('addQuickRowBtn').addEventListener('click', addQuickRow);
    document.addEventListener('input', (e) => { if (e.target.closest('#quickCgpaRows')) recalcQuickAvg(); });
  </script>
  <script>
    document.getElementById('addSubjectRowBtn').addEventListener('click', function () {
      const wrap = document.getElementById('subjectRows');
      const row = document.createElement('div');
      row.className = 'marks-row';
      row.style.gridTemplateColumns = '2fr 1fr 1fr auto';
      row.innerHTML = `
        <input type="text" name="name" class="field" style="padding:9px 12px;" placeholder="Subject name">
        <input type="number" name="credits" min="1" max="10" class="field" style="padding:9px 12px;" placeholder="Credits">
        <input type="number" name="marks" min="0" max="100" class="field" style="padding:9px 12px;" placeholder="Marks">
        <button type="button" class="remove" onclick="this.closest('.marks-row').remove();">✕</button>
      `;
      wrap.appendChild(row);
    });
  </script>
  <script src="/js/main.js"></script>
  <script src="/js/upgrade.js"></script>
  <script src="/js/focus.js"></script>
</body>
</html>
