<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Dashboard — SkillSprint</title>
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="/css/dashboard.css">
  <link rel="stylesheet" href="/css/upgrade.css">
</head>
<body>
  <div class="app-shell">
    <%- include('partials/sidebar', { active: 'dashboard', user }) %>

    <div class="main">
      <%- include('partials/topbar', { user }) %>

      <div class="dcontent">
        <div class="photo-banner reveal">
          <%- include('partials/banner-photo', { user }) %>
          <div class="banner-body">
            <h1>Welcome back, <span class="name-accent"><%= user.fullName.split(' ')[0] %>!</span></h1>
            <div class="banner-tagline"><span class="t1">Keep learning, keep</span> <span class="t2">sprinting. ⚡</span></div>
            <p class="banner-desc">Every small step you take today brings you closer to your big dreams.</p>
          </div>
        </div>

        <div class="section-card">
          <div class="section-head">
            <h3>📊 Your Snapshot</h3>
            <% if (availableSems && availableSems.length) { %>
              <form method="get" action="/dashboard" style="display:flex; align-items:center; gap:8px;">
                <span class="hint-text">Semester</span>
                <select name="sem" class="field" style="padding:6px 10px; width:auto;" onchange="this.form.submit()">
                  <% availableSems.forEach(s => { %>
                    <option value="<%= s %>" <%= currentSem === s ? 'selected' : '' %>>Semester <%= s %></option>
                  <% }) %>
                </select>
              </form>
            <% } %>
            <button class="focus-toggle">🎯 Focus</button>
          </div>
          <div class="stat-grid stat-grid-4">
            <div class="stat-tile">
              <div class="num" style="color: <%= overall && overall.pct >= 75 ? 'var(--green)' : 'var(--red)' %>;"><%= overall && overall.total > 0 ? overall.pct + '%' : '—' %></div>
              <div class="lbl">Attendance<% if (currentSem) { %> (Sem <%= currentSem %>)<% } %></div>
            </div>
            <div class="stat-tile">
              <div class="num"><%= overallCgpaVal || '—' %></div>
              <div class="lbl">Overall CGPA</div>
            </div>
            <div class="stat-tile">
              <div class="num"><%= reminders.length %></div>
              <div class="lbl">Pending Reminders</div>
            </div>
            <div class="stat-tile">
              <div class="num"><%= notesCount %></div>
              <div class="lbl">Notes Saved</div>
            </div>
          </div>
        </div>

        <div class="section-card">
          <div class="section-head">
            <h3>⚡ Quick Access</h3>
            <button class="focus-toggle">🎯 Focus</button>
          </div>
          <div class="quick-links">
            <a href="/attendance" class="quick-link"><div class="ql-icon">📅</div><div class="ql-title">Attendance</div></a>
            <a href="/notes" class="quick-link"><div class="ql-icon">📝</div><div class="ql-title">Notes</div></a>
            <a href="/cgpa" class="quick-link"><div class="ql-icon">🧮</div><div class="ql-title">CGPA Calculator</div></a>
            <a href="/reminders" class="quick-link"><div class="ql-icon">🔔</div><div class="ql-title">Reminders</div></a>
            <a href="/community" class="quick-link"><div class="ql-icon">💬</div><div class="ql-title">Community</div></a>
          </div>
        </div>

        <div class="section-card">
          <div class="section-head">
            <h3>🔔 Upcoming Reminders</h3>
            <button class="focus-toggle">🎯 Focus</button>
          </div>
          <% if (reminders.length === 0) { %>
            <p class="hint-text">Nothing pending — add tasks your teacher assigns from the Reminders page.</p>
          <% } else { %>
            <% reminders.forEach(r => { %>
              <div class="reminder-row">
                <span class="r-subject"><%= r.subject %></span>
                <span class="r-task"><%= r.task %></span>
                <span class="r-due"><%= r.dueDate || '' %></span>
              </div>
            <% }) %>
          <% } %>
        </div>

        <div class="motivation-card">
          <div class="m-icon">💡</div>
          <h4>Your Goals Matter</h4>
          <p>Stay consistent. You're doing great!</p>
        </div>
      </div>
    </div>
  </div>
  <script src="/js/main.js"></script>
  <script src="/js/upgrade.js"></script>
  <script src="/js/focus.js"></script>
</body>
</html>
