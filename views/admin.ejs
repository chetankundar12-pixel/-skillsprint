<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Owner Panel — SkillSprint</title>
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="/css/dashboard.css">
  <link rel="stylesheet" href="/css/upgrade.css">
</head>
<body>
  <%
  var added = locals.added || false, bad = locals.bad || false;
  var resources = locals.resources || [];
  var schemes = locals.schemes || ['NEP 2020', 'R-19'];
  var resTypes = locals.resTypes || ['Syllabus', 'PYQ', 'Notes'];
%>
  <div class="app-shell">
    <%- include('partials/sidebar', { active: 'admin', user }) %>
    <div class="main">
      <%- include('partials/topbar', { user }) %>
      <div class="dcontent">
        <div class="photo-banner reveal">
          <div class="banner-body">
            <h1><span class="name-accent">Owner Panel</span></h1>
            <p class="banner-desc">Send a notification. It shows up in the bell of every student it is meant for.</p>
          </div>
        </div>

        <div class="section-card">
          <div class="section-head"><h3>New notification</h3></div>
          <% if (sent) { %><div class="notice">Sent. Students will see it in their bell.</div><% } %>
          <form method="post" action="/admin/announce" class="admin-form">
            <div>
              <label class="field-label">Title</label>
              <div class="field"><input type="text" name="title" maxlength="80" placeholder="e.g. Unit test on Monday" required></div>
            </div>
            <div>
              <label class="field-label">Message (optional)</label>
              <div class="field"><input type="text" name="message" maxlength="400" placeholder="A short detail students should know"></div>
            </div>
            <div>
              <label class="field-label">Send to</label>
              <div class="field">
                <select name="audience" id="audSel">
                  <option value="all">All students</option>
                  <option value="year">One year only</option>
                </select>
              </div>
            </div>
            <div id="yearWrap" style="display:none;">
              <label class="field-label">Year</label>
              <div class="field">
                <select name="year"><% years.forEach(y => { %><option value="<%= y %>"><%= y %></option><% }) %></select>
              </div>
            </div>
            <button type="submit" class="btn btn-primary">Send notification</button>
          </form>
        </div>

        <div class="section-card">
          <div class="section-head"><h3>Add to Study Library</h3></div>
          <p class="hint-text">Upload PDFs, Word, PowerPoint or images (up to 25 MB each, 10 at a time). They appear straight away for students.</p>
          <% if (added) { %><div class="notice">Added. Students will see it in Notes &amp; Resources.</div><% } %>
          <% if (bad) { %><div class="notice warn">Please choose at least one file (PDF, DOC, PPT, XLS, image or ZIP, max 25 MB) and a semester.</div><% } %>
          <form method="post" action="/admin/resource" enctype="multipart/form-data" class="admin-form">
            <div>
              <label class="field-label">Scheme</label>
              <div class="field"><select name="scheme"><% schemes.forEach(sc => { %><option value="<%= sc %>"><%= sc %></option><% }) %></select></div>
            </div>
            <div>
              <label class="field-label">Semester</label>
              <div class="field"><select name="sem"><% [1,2,3,4,5,6,7,8].forEach(n => { %><option value="<%= n %>">Semester <%= n %></option><% }) %></select></div>
            </div>
            <div>
              <label class="field-label">Type</label>
              <div class="field"><select name="type"><% resTypes.forEach(t => { %><option value="<%= t %>"><%= t === 'PYQ' ? 'PYQ (previous year papers)' : t %></option><% }) %></select></div>
            </div>
            <div>
              <label class="field-label">Subject (optional)</label>
              <div class="field"><input type="text" name="subject" maxlength="80" placeholder="e.g. Engineering Mathematics I"></div>
            </div>
            <div>
              <label class="field-label">Title (optional)</label>
              <div class="field"><input type="text" name="title" maxlength="100" placeholder="Leave empty to use the file name"></div>
            </div>
            <div class="file-drop">
              <label class="field-label" for="libFiles">Files</label>
              <input type="file" id="libFiles" name="files" multiple required accept=".pdf,.doc,.docx,.ppt,.pptx,.xls,.xlsx,.txt,.zip,.jpg,.jpeg,.png">
              <span class="file-hint" id="libFilesHint">No file chosen</span>
            </div>
            <button type="submit" class="btn btn-primary">Add to library</button>
          </form>

          <% if (resources.length) { %>
            <ul class="admin-list" style="margin-top:18px;">
              <% resources.forEach(r => { %>
                <li>
                  <div>
                    <b><%= r.title %></b>
                    <em><%= r.scheme %> · Sem <%= r.sem %> · <%= r.type %><%= r.subject ? ' · ' + r.subject : '' %></em>
                    <span><a href="<%= r.url %>" target="_blank" rel="noopener noreferrer"><%= r.file ? 'View file' : 'Open link' %></a></span>
                  </div>
                  <form method="post" action="/admin/resource/delete">
                    <input type="hidden" name="resourceId" value="<%= r.id %>">
                    <button type="submit" class="btn btn-outline">Delete</button>
                  </form>
                </li>
              <% }) %>
            </ul>
          <% } %>
        </div>

        <div class="section-card">
          <div class="section-head"><h3>Sent notifications</h3></div>
          <% if (!announcements.length) { %>
            <p class="hint-text">Nothing sent yet.</p>
          <% } else { %>
            <ul class="admin-list">
              <% announcements.forEach(n => { %>
                <li>
                  <div>
                    <b><%= n.title %></b>
                    <% if (n.message) { %><span><%= n.message %></span><% } %>
                    <em><%= n.createdLabel %> · <%= n.audience === 'year' ? n.year : 'All students' %></em>
                  </div>
                  <form method="post" action="/admin/announce/delete">
                    <input type="hidden" name="announceId" value="<%= n.id %>">
                    <button type="submit" class="btn btn-outline">Delete</button>
                  </form>
                </li>
              <% }) %>
            </ul>
          <% } %>
        </div>
      </div>
    </div>
  </div>
  <script>
    var lf = document.getElementById('libFiles'), lh = document.getElementById('libFilesHint');
    if (lf) lf.addEventListener('change', function () { lh.textContent = lf.files.length ? lf.files.length + ' file(s) selected' : 'No file chosen'; });
    var aud = document.getElementById('audSel'), yw = document.getElementById('yearWrap');
    aud.addEventListener('change', function () { yw.style.display = aud.value === 'year' ? 'block' : 'none'; });
  </script>
  <script src="/js/main.js"></script>
  <script src="/js/upgrade.js"></script>
</body>
</html>
