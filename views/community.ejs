<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Community — SkillSprint</title>
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="/css/dashboard.css">
</head>
<body>
  <div class="app-shell">
    <%- include('partials/sidebar', { active: 'community' }) %>

    <div class="main">
      <div class="topbar"><h2>Community</h2></div>

      <div class="dcontent">
        <div class="page-banner icon-banner reveal">
          <div class="banner-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/></svg>
          </div>
          <div class="page-banner-content">
            <h1>Community</h1>
            <p>Your college, your year, your stream — all in one chat.</p>
          </div>
        </div>

        <% if (!supported) { %>
          <div class="section-card">
            <div class="section-head"><h3>Community chat</h3></div>
            <p class="hint-text">Community groups are set up for First Year and Second Year students right now — <%= user.year %> is coming soon.</p>
          </div>
        <% } else { %>
          <div class="section-card">
            <div class="section-head">
              <h3>💬 <%= user.college %> · <%= user.year %> · <%= user.stream %></h3>
              <button class="focus-toggle">🎯 Focus</button>
            </div>
            <p class="hint-text">You're auto-joined here because of your college, year, and stream — everyone in this group sees the same chat.</p>

            <div class="chat-window" id="chatWindow">
              <% messages.forEach(m => { %>
                <div class="chat-bubble <%= m.name === user.fullName ? 'me' : '' %>">
                  <div class="cb-name"><%= m.name %></div>
                  <%= m.text %>
                </div>
              <% }) %>
            </div>

            <div class="chat-input-row">
              <div class="field" style="flex:1;"><input type="text" id="chatInput" placeholder="Message your batch..."></div>
              <button id="chatSendBtn" class="btn btn-primary">Send</button>
            </div>
          </div>
        <% } %>
      </div>
    </div>
  </div>
  <script src="/js/main.js"></script>
  <script src="/js/focus.js"></script>
  <% if (supported) { %>
  <script src="/socket.io/socket.io.js"></script>
  <script>
    const socket = io();
    const myName = <%- JSON.stringify(user.fullName) %>;
    const win = document.getElementById('chatWindow');

    // Built with DOM methods + textContent (never innerHTML) so a message
    // like "<img src=x onerror=...>" is always shown as plain text instead
    // of being executed as HTML/JS in everyone else's chat window.
    function appendBubble(m) {
      const div = document.createElement('div');
      div.className = 'chat-bubble' + (m.name === myName ? ' me' : '');

      const nameDiv = document.createElement('div');
      nameDiv.className = 'cb-name';
      nameDiv.textContent = m.name;

      div.appendChild(nameDiv);
      div.appendChild(document.createTextNode(m.text));

      win.appendChild(div);
      win.scrollTop = win.scrollHeight;
    }

    socket.on('chat:message', appendBubble);

    document.getElementById('chatSendBtn').addEventListener('click', send);
    document.getElementById('chatInput').addEventListener('keydown', (e) => { if (e.key === 'Enter') send(); });

    function send() {
      const input = document.getElementById('chatInput');
      if (!input.value.trim()) return;
      socket.emit('chat:send', input.value);
      input.value = '';
    }

    win.scrollTop = win.scrollHeight;
  </script>
  <% } %>
</body>
</html>
