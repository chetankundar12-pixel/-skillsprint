<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Community — SkillSprint</title>
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="/css/dashboard.css">
  <link rel="stylesheet" href="/css/upgrade.css">
</head>
<body>
  <div class="app-shell">
    <%- include('partials/sidebar', { active: 'community', user }) %>

    <div class="main">
      <%- include('partials/topbar', { user }) %>

      <div class="dcontent">
        <div class="photo-banner reveal">
          <%- include('partials/banner-photo', { user }) %>
          <div class="banner-body">
            <h1>💬 <span class="name-accent">Community</span></h1>
            <div class="banner-tagline"><span class="t1">Learn. Share.</span> <span class="t2">Grow together.</span></div>
            <p class="banner-desc">Connect with your college, year, and stream — all in one live chat.</p>
          </div>
        </div>

        <% if (!supported) { %>
          <div class="section-card">
            <div class="section-head"><h3>Community chat</h3></div>
            <p class="hint-text">Community groups are set up for First Year and Second Year students right now — <%= user.year %> is coming soon.</p>
          </div>
        <% } else { %>
        <div style="display:grid; grid-template-columns:2fr 1fr; gap:20px; align-items:start;">
          <div class="section-card">
            <div class="section-head">
              <h3>💬 <%= user.college %> · <%= user.year %> · <%= user.stream %></h3>
              <button class="focus-toggle">🎯 Focus</button>
            </div>
            <p class="hint-text">You're auto-joined here because of your college, year, and stream — everyone in this group sees the same live chat.</p>

            <div class="chat-window" id="chatWindow">
              <% messages.forEach(m => { %>
                <div class="chat-bubble <%= m.name === user.fullName ? 'me' : '' %>">
                  <div class="cb-name"><%= m.name %></div>
                  <%= m.text %>
                </div>
              <% }) %>
            </div>

            <div class="chat-input-row">
              <div class="field" style="flex:1;"><input type="text" id="chatInput" placeholder="Message your batch..."></div>
              <button id="chatSendBtn" class="btn btn-primary">Send</button>
            </div>
          </div>

          <div>
            <div class="section-card">
              <div class="section-head"><h3>📊 Chat Stats</h3></div>
              <div class="stat-grid" style="grid-template-columns:1fr;">
                <div class="stat-tile"><div class="num"><%= messages.length %></div><div class="lbl">Messages in this chat</div></div>
              </div>
            </div>
            <div class="motivation-card">
              <div class="m-icon">💡</div>
              <h4>Great things happen</h4>
              <p>when learners connect. — SkillSprint</p>
            </div>
          </div>
        </div>
        <% } %>
      </div>
    </div>
  </div>
  <script src="/js/main.js"></script>
  <script src="/js/focus.js"></script>
  <% if (supported) { %>
  <script src="/socket.io/socket.io.js"></script>
  <script>
    const socket = io();
    const myName = <%- JSON.stringify(user.fullName) %>;
    const win = document.getElementById('chatWindow');

    function appendBubble(m) {
      const div = document.createElement('div');
      div.className = 'chat-bubble' + (m.name === myName ? ' me' : '');
      div.innerHTML = `<div class="cb-name">${m.name}</div>${m.text}`;
      win.appendChild(div);
      win.scrollTop = win.scrollHeight;
    }

    socket.on('chat:message', appendBubble);

    document.getElementById('chatSendBtn').addEventListener('click', send);
    document.getElementById('chatInput').addEventListener('keydown', (e) => { if (e.key === 'Enter') send(); });

    function send() {
      const input = document.getElementById('chatInput');
      if (!input.value.trim()) return;
      socket.emit('chat:send', input.value);
      input.value = '';
    }

    win.scrollTop = win.scrollHeight;
  </script>
  <% } %>
</body>
</html>
