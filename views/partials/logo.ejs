<%
  // SkillSprint brand mark v2 — three ascending bars (progress / growth),
  // not a hand-drawn letterform. Chosen specifically because it's built
  // from plain rectangles, not a freehand curve, so it can't come out
  // lopsided or rough — guaranteed clean at any size.
  // Uses currentColor so it always matches .brand-mark's color:#fff.
  //
  // Drop it inside the existing badge div in place of the old icon.
  // Reminder: never write EJS delimiter characters inside a comment —
  // see the note in partials/head.ejs.
%>
<svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
  <rect x="3"  y="13" width="4.5" height="8"  rx="1.6" fill="currentColor"/>
  <rect x="9.75" y="8" width="4.5" height="13" rx="1.6" fill="currentColor"/>
  <rect x="16.5" y="3" width="4.5" height="18" rx="1.6" fill="currentColor"/>
</svg>
