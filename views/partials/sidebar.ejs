<div class="sidebar">
  <div class="brand">
    <div class="brand-mark" aria-hidden="true"><%- include('logo') %></div>
    <div><div class="brand-name">Skill <span>Sprint</span></div></div>
  </div>

  <div class="sidebar-user">
    <% if (user.fullName && user.fullName.split(' ')[0].toLowerCase() === 'chetan') { %>
      <img class="avatar-photo" src="/img/chetan.jpg" alt="<%= user.fullName %>">
    <% } else if (user.fullName && ['aaditya','aditiya'].includes(user.fullName.split(' ')[0].toLowerCase())) { %>
      <img class="avatar-photo" src="/img/aaditya.jpg" alt="<%= user.fullName %>">
    <% } else { %>
      <div class="avatar"><%= (user.fullName || 'U').charAt(0).toUpperCase() %></div>
    <% } %>
    <div>
      <div class="su-name"><%= user.fullName %></div>
      <div class="su-sub"><%= user.year %> · <%= user.stream %></div>
    </div>
  </div>

  <div class="nav-section">
    <a href="/dashboard" class="nav-item <%= active === 'dashboard' ? 'active' : '' %>">
      <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
        <path d="M4 10.5L12 4l8 6.5"/>
        <path d="M6 9v9a1 1 0 0 0 1 1h3v-5h4v5h3a1 1 0 0 0 1-1V9"/>
      </svg>
      Dashboard
    </a>
    <a href="/notes" class="nav-item <%= active === 'notes' ? 'active' : '' %>">
      <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
        <rect x="5" y="3" width="14" height="18" rx="2"/>
        <line x1="8" y1="8" x2="16" y2="8"/>
        <line x1="8" y1="12" x2="16" y2="12"/>
        <line x1="8" y1="16" x2="13" y2="16"/>
      </svg>
      Notes & Resources
    </a>
    <a href="/cgpa" class="nav-item <%= active === 'cgpa' ? 'active' : '' %>">
      <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
        <rect x="5" y="3" width="14" height="18" rx="2"/>
        <line x1="5" y1="8" x2="19" y2="8"/>
        <line x1="9.5" y1="8" x2="9.5" y2="21"/>
        <line x1="14.5" y1="8" x2="14.5" y2="21"/>
        <line x1="5" y1="13" x2="19" y2="13"/>
        <line x1="5" y1="17" x2="19" y2="17"/>
      </svg>
      CGPA Calculator
    </a>
    <a href="/attendance" class="nav-item <%= active === 'attendance' ? 'active' : '' %>">
      <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
        <rect x="4" y="5" width="16" height="15" rx="2"/>
        <line x1="4" y1="9" x2="20" y2="9"/>
        <line x1="8" y1="3" x2="8" y2="6"/>
        <line x1="16" y1="3" x2="16" y2="6"/>
        <polyline points="8,14 11,17 16,11"/>
      </svg>
      Attendance
    </a>
    <a href="/progress" class="nav-item <%= active === 'progress' ? 'active' : '' %>">
      <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
        <polyline points="4,18 9,12 13,15 20,6"/>
        <polyline points="15,6 20,6 20,11"/>
      </svg>
      Progress
    </a>
    <a href="/reminders" class="nav-item <%= active === 'reminders' ? 'active' : '' %>">
      <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
        <path d="M8 8 L8 12 L5 17 L19 17 L16 12 L16 8 Z"/>
        <rect x="10" y="18.4" width="4" height="1.8" rx="0.9" fill="currentColor" stroke="none"/>
      </svg>
      Reminders
    </a>
    <a href="/community" class="nav-item <%= active === 'community' ? 'active' : '' %>">
      <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
        <path d="M4 5 H20 V15 H9 L5 19 V15 H4 Z"/>
      </svg>
      Community
    </a>
    <div class="nav-divider"></div>
    <a href="/logout" class="nav-item">
      <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
        <rect x="4" y="4" width="9" height="16" rx="1"/>
        <line x1="9" y1="12" x2="20" y2="12"/>
        <polyline points="16,8 20,12 16,16"/>
      </svg>
      Logout
    </a>
  </div>

  <div class="sidebar-footer">
    <strong style="color:var(--muted); display:flex; align-items:center; gap:5px; font-size:.78rem;">⚡ Small Steps Big Dreams</strong>
    <div style="height:3px; border-radius:999px; background:#1c2140; margin-top:7px; overflow:hidden; width:70%;">
      <div style="height:100%; width:68%; background:var(--grad-wide); border-radius:999px;"></div>
    </div>
  </div>
</div>
