<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('partials/head', { title: title, app: false }) %>
</head>
<body>
  <div class="container">
    <header class="site-header">
      <div class="header-inner">
        <a href="/" class="brand">
          <div class="brand-mark" aria-hidden="true"><%- include('partials/logo') %></div>
          <div><div class="brand-name">Skill<span>Sprint</span></div></div>
        </a>
      </div>
    </header>

    <main style="min-height:60vh; display:flex; align-items:center; justify-content:center; padding:40px 0;">
      <div class="auth-card" style="text-align:center; max-width:460px;">
        <div style="font-size:3rem; margin-bottom:6px;"><%= code === 404 ? '🧭' : '⚠️' %></div>
        <h2><%= title %></h2>
        <p class="sub"><%= message %></p>
        <div style="display:flex; gap:10px; justify-content:center; margin-top:10px; flex-wrap:wrap;">
          <% if (user) { %>
            <a href="/dashboard" class="btn btn-primary">← Back to Dashboard</a>
          <% } else { %>
            <a href="/" class="btn btn-primary">← Back to Home</a>
            <a href="/login" class="btn btn-outline">Log in</a>
          <% } %>
        </div>
      </div>
    </main>
  </div>
</body>
</html>
