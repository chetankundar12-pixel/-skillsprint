<div class="topbar2">
  <button class="mobile-nav-toggle" type="button" aria-expanded="false" aria-controls="appSidebar" aria-label="Open menu">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><line x1="4" y1="7" x2="20" y2="7"/><line x1="4" y1="12" x2="20" y2="12"/><line x1="4" y1="17" x2="20" y2="17"/></svg>
  </button>
  <div class="topbar-search">
    🔍 <input type="text" placeholder="Search courses, topics, or resources...">
  </div>
  <div class="topbar-bell">🔔<span class="dot"></span></div>
  <div class="topbar-user2" id="userMenuTrigger">
    <button type="button" class="user-menu-btn" aria-expanded="false" aria-haspopup="true" aria-controls="userMenu">
      <span class="avatar" aria-hidden="true"><%= (user.fullName || 'U').trim().charAt(0).toUpperCase() %></span>
      <span class="tu-name"><%= user.fullName ? user.fullName.split(' ')[0] : '' %></span> ▾
    </button>
    <div class="user-menu" id="userMenu">
      <a href="/profile"><svg class="menu-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="8" r="4"/><path d="M4 21v-1a6 6 0 0 1 6-6h4a6 6 0 0 1 6 6v1"/></svg> Edit Profile</a>
      <a href="/logout"><svg class="menu-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg> Logout</a>
    </div>
  </div>
</div>
