<%
  // SkillSprint hero illustration — original artwork, built directly as
  // SVG shapes (circles, rectangles, straight-line polygons), not
  // sourced from any image, photo, or generator.
  //
  // viewBox is landscape (520x400) to match the hero box's actual
  // proportions, so content spreads across the full frame instead of
  // sitting in a centered square with empty space on the sides.
  // preserveAspectRatio="xMidYMid slice" is a safety net on top of
  // that — if a page uses this in a box with a different aspect ratio
  // (e.g. the narrower auth-page mascot slot), it scales to fully
  // COVER the box and crops overflow, the same way object-fit:cover
  // works for a photo, rather than ever letterboxing.
%>
<svg width="100%" height="100%" viewBox="0 0 520 400" preserveAspectRatio="xMidYMid slice" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="SkillSprint illustration">
  <defs>
    <linearGradient id="illuBg" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0%" stop-color="#1b1030"/>
      <stop offset="100%" stop-color="#0d1226"/>
    </linearGradient>
    <linearGradient id="illuAccent" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0%" stop-color="#8b5cf6"/>
      <stop offset="100%" stop-color="#22d3ee"/>
    </linearGradient>
  </defs>

  <rect x="0" y="0" width="520" height="400" fill="url(#illuBg)"/>

  <!-- ambient glow blobs -->
  <circle cx="110" cy="90" r="110" fill="#8b5cf6" opacity=".18"/>
  <circle cx="420" cy="310" r="130" fill="#22d3ee" opacity=".14"/>

  <!-- graduation cap -->
  <polygon points="260,108 372,154 260,200 148,154" fill="url(#illuAccent)"/>
  <rect x="233" y="154" width="54" height="27" rx="5" fill="#e9e7ff"/>
  <line x1="347" y1="154" x2="347" y2="203" stroke="#e9e7ff" stroke-width="4" stroke-linecap="round"/>
  <circle cx="347" cy="212" r="7" fill="#f59e0b"/>

  <!-- book stack -->
  <rect x="190" y="252" width="150" height="19" rx="4" fill="#8b5cf6"/>
  <rect x="206" y="232" width="118" height="19" rx="4" fill="#22d3ee"/>
  <rect x="222" y="212" width="86" height="19" rx="4" fill="#e9e7ff"/>

  <!-- progress arrow, lower-left -->
  <polyline points="55,335 108,282 145,306 188,252" fill="none" stroke="#e9e7ff" stroke-width="6" stroke-linecap="round" stroke-linejoin="round"/>
  <polyline points="161,252 188,252 188,279" fill="none" stroke="#e9e7ff" stroke-width="6" stroke-linecap="round" stroke-linejoin="round"/>

  <!-- achievement badge, top-right -->
  <circle cx="445" cy="92" r="40" fill="rgba(255,255,255,.08)" stroke="#e9e7ff" stroke-width="2.5"/>
  <polyline points="427,92 440,105 466,76" fill="none" stroke="#22d3ee" stroke-width="5" stroke-linecap="round" stroke-linejoin="round"/>

  <!-- sparkle accents -->
  <circle cx="465" cy="215" r="5" fill="#f59e0b"/>
  <circle cx="80" cy="235" r="4" fill="#22d3ee"/>
  <circle cx="305" cy="345" r="4" fill="#ec4899"/>
</svg>
