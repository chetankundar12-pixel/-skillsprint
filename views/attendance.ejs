<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Attendance — SkillSprint</title>
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="/css/dashboard.css">
  <link rel="stylesheet" href="/css/upgrade.css">
</head>
<body>
  <div class="app-shell">
    <%- include('partials/sidebar', { active: 'attendance', user }) %>

    <div class="main">
      <%- include('partials/topbar', { user }) %>

      <div class="dcontent">
        <div class="photo-banner reveal">
          <%- include('partials/banner-photo', { user }) %>
          <div class="banner-body">
            <h1>📅 <span class="name-accent">Attendance</span></h1>
            <div class="banner-tagline"><span class="t1">Be present.</span> <span class="t2">Build your future.</span></div>
            <p class="banner-desc">Track your class attendance, stay consistent, and achieve your goals.</p>
          </div>
        </div>

        <div style="display:grid; grid-template-columns:1fr 1fr; gap:20px; align-items:start;">
          <div class="section-card">
            <div class="section-head">
              <h3>Overall Attendance</h3>
              <% if (availableSems && availableSems.length) { %>
                <form method="get" action="/attendance" style="display:flex; align-items:center; gap:8px;">
                  <span class="hint-text">Semester</span>
                  <select name="sem" class="field" style="padding:6px 10px; width:auto;" onchange="this.form.submit()">
                    <% availableSems.forEach(s => { %>
                      <option value="<%= s %>" <%= currentSem === s ? 'selected' : '' %>>Semester <%= s %></option>
                    <% }) %>
                  </select>
                </form>
              <% } %>
              <button class="focus-toggle">🎯 Focus</button>
            </div>
            <% const pct = overall.total === 0 ? 0 : overall.pct; const circumference = 2 * Math.PI * 50; const dash = (pct/100) * circumference; %>
            <div style="display:flex; align-items:center; gap:22px;">
              <div class="ring-wrap">
                <svg viewBox="0 0 120 120">
                  <circle cx="60" cy="60" r="50" fill="none" stroke="#232a4a" stroke-width="12"/>
                  <circle cx="60" cy="60" r="50" fill="none" stroke="<%= pct >= 75 ? '#22c55e' : '#ef4444' %>" stroke-width="12" stroke-linecap="round"
                    stroke-dasharray="<%= dash %> <%= circumference %>"/>
                </svg>
                <div class="ring-label"><b><%= overall.total === 0 ? '—' : pct + '%' %></b><span><%= overall.total === 0 ? 'No data' : (pct >= 75 ? 'Good' : 'Low') %></span></div>
              </div>
              <div style="flex:1;">
                <div class="hint-text" style="margin-bottom:8px; font-size:.85rem;"><%= overall.attended %> / <%= overall.total %> classes</div>
                <div class="stat-grid" style="grid-template-columns:1fr 1fr; gap:10px;">
                  <div class="stat-tile" style="padding:10px;"><div class="num" style="font-size:1.1rem; color:var(--green);"><%= overall.attended %></div><div class="lbl">Present</div></div>
                  <div class="stat-tile" style="padding:10px;"><div class="num" style="font-size:1.1rem; color:var(--red);"><%= overall.missed %></div><div class="lbl">Absent</div></div>
                </div>
              </div>
            </div>
          </div>

          <div class="section-card">
            <div class="section-head">
              <h3>Attendance Calendar — <%= monthLabel %></h3>
              <button class="focus-toggle">🎯 Focus</button>
            </div>
            <div class="mini-cal">
              <div class="dow">Mon</div><div class="dow">Tue</div><div class="dow">Wed</div><div class="dow">Thu</div><div class="dow">Fri</div><div class="dow">Sat</div><div class="dow">Sun</div>
              <% calendarDays.forEach(d => { %>
                <% if (d === null) { %>
                  <div class="day empty"></div>
                <% } else { %>
                  <%
                    let cls = 'day';
                    if (dayStatus[d] === 'present') cls += ' present';
                    else if (dayStatus[d] === 'absent') cls += ' absent';
                    if (d === todayDate) cls += ' today';
                  %>
                  <div class="<%= cls %>"><%= d %></div>
                <% } %>
              <% }) %>
            </div>
            <div class="cal-legend">
              <span><i style="background:var(--green);"></i>Present day</span>
              <span><i style="background:var(--red);"></i>Absent day</span>
              <span><i style="border:2px solid var(--purple); background:transparent;"></i>Today</span>
            </div>
          </div>
        </div>

        <div class="section-card">
          <div class="section-head">
            <h3>Subject-wise Attendance</h3>
            <button class="focus-toggle">🎯 Focus</button>
          </div>
          <% rows.forEach((r, i) => {
            const colors = ['#8b5cf6','#3b82f6','#22d3ee','#ec4899','#f59e0b','#22c55e'];
            const dotColor = colors[i % colors.length];
            let tier = 'low', tierLabel = 'Needs Attention';
            if (r.total === 0) { tier = null; }
            else if (r.pct >= 90) { tier = 'excellent'; tierLabel = 'Excellent'; }
            else if (r.pct >= 75) { tier = 'good'; tierLabel = 'Good'; }
            else if (r.pct >= 60) { tier = 'average'; tierLabel = 'Average'; }
          %>
          <div class="subject-line">
            <span class="subject-dot" style="background:<%= dotColor %>;"></span>
            <span class="sname"><%= r.name %></span>
            <span class="spct"><%= r.total === 0 ? '—' : r.pct + '%' %></span>
            <% if (tier) { %><span class="tier-pill tier-<%= tier %>"><%= tierLabel %></span><% } %>
          </div>
          <% }) %>

          <form method="post" action="/attendance/add-subject" class="add-subject-row">
            <input type="hidden" name="sem" value="<%= currentSem || '' %>">
            <input type="text" name="newSubject" class="field" style="padding:10px 14px;" placeholder="Add another subject (e.g. an elective)">
            <button class="btn btn-outline" type="submit">+ Add</button>
          </form>
        </div>

        <div class="section-card">
          <div class="section-head">
            <h3>Mark Today's Lecture</h3>
            <button class="focus-toggle">🎯 Focus</button>
          </div>
          <table class="attend-table">
            <thead><tr><th>Subject</th><th>What was taught</th><th></th></tr></thead>
            <tbody>
              <% rows.forEach(r => { %>
                <tr>
                  <td><%= r.name %></td>
                  <td>
                    <form method="post" action="/attendance/mark" id="markform-<%= r.name.replace(/[^a-zA-Z0-9]/g,'') %>" class="mark-form-row">
                      <input type="hidden" name="subject" value="<%= r.name %>">
                      <input type="hidden" name="sem" value="<%= currentSem || '' %>">
                      <input type="text" name="note" placeholder="What was taught? (optional)">
                    </form>
                  </td>
                  <td>
                    <div class="mark-btns">
                      <button class="mark-btn present" type="submit" form="markform-<%= r.name.replace(/[^a-zA-Z0-9]/g,'') %>" name="action" value="present">✓ Present</button>
                      <button class="mark-btn absent" type="submit" form="markform-<%= r.name.replace(/[^a-zA-Z0-9]/g,'') %>" name="action" value="absent">✕ Absent</button>
                    </div>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>

        <div class="section-card">
          <div class="section-head">
            <h3>📖 Attendance History</h3>
            <% if (rows && rows.length) { %>
              <div style="display:flex; align-items:center; gap:8px;">
                <span class="hint-text">Subject</span>
                <select id="historySubjectFilter" class="field" style="padding:6px 10px; width:auto;">
                  <option value="all">All subjects</option>
                  <% rows.forEach(r => { %>
                    <option value="<%= r.name %>"><%= r.name %></option>
                  <% }) %>
                </select>
              </div>
            <% } %>
            <button class="focus-toggle">🎯 Focus</button>
          </div>
          <p class="hint-text" style="margin-bottom:12px;">Every lecture you've marked, with the date, time, and what was covered — this is what you'd show a teacher.</p>
          <% if (history.length === 0) { %>
            <p class="history-empty">No lectures marked yet.</p>
          <% } else { %>
            <table class="history-table">
              <thead><tr><th>Date</th><th>Time</th><th>Subject</th><th>Status</th><th>What was taught</th></tr></thead>
              <tbody id="historyBody">
                <% history.forEach(h => { %>
                  <tr data-subject="<%= h.subject %>">
                    <td><%= h.date %></td>
                    <td><%= h.time %></td>
                    <td><%= h.subject %></td>
                    <td><span class="history-status <%= h.status.toLowerCase() %>"><%= h.status %></span></td>
                    <td class="history-note"><%= h.note || '—' %></td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
            <p id="historyEmptyFiltered" class="history-empty" style="display:none;">No lectures marked for this subject yet.</p>
          <% } %>
        </div>
      </div>
    </div>
  </div>
  <script src="/js/main.js"></script>
  <script src="/js/focus.js"></script>
  <script>
    // History subject filter — starts on "All subjects", switching to a
    // specific one shows just that subject's lectures. Pure client-side
    // (no page reload) so it's quick to flip through live, e.g. when
    // showing a teacher your attendance for their subject specifically.
    (function () {
      var select = document.getElementById('historySubjectFilter');
      var body = document.getElementById('historyBody');
      var emptyMsg = document.getElementById('historyEmptyFiltered');
      if (!select || !body) return;

      select.addEventListener('change', function () {
        var chosen = select.value;
        var visibleCount = 0;
        Array.prototype.forEach.call(body.querySelectorAll('tr'), function (row) {
          var show = chosen === 'all' || row.getAttribute('data-subject') === chosen;
          row.style.display = show ? '' : 'none';
          if (show) visibleCount++;
        });
        if (emptyMsg) emptyMsg.style.display = visibleCount === 0 ? '' : 'none';
      });
    })();
  </script>
</body>
</html>
