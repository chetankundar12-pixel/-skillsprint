<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Login — SkillSprint</title>
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <div class="container">
    <header class="site-header reveal">
      <a href="/" class="brand">
        <div class="brand-mark">S</div>
        <div>
          <div class="brand-name">Skill<span>Sprint</span></div>
          <div class="brand-tag">Smart Student Progress Tracker</div>
        </div>
      </a>
      <nav class="site-nav">
        <a href="/signup" class="btn btn-outline">Create account →</a>
      </nav>
    </header>

    <div class="auth-wrap">
      <div class="auth-side reveal reveal-1">
        <div class="hero-eyebrow">✨ Plan · Study · Achieve</div>
        <h1 style="font-size:2.6rem; line-height:1.1; margin:0 0 18px;">
          <span class="g1">Your Goals.</span><br><span class="g2">Our Tracker.</span><br><span class="g3">Better You.</span>
        </h1>
        <p class="lede">Track attendance, calculate CGPA, take notes, and stay connected with your batch — all in one place.</p>

        <div class="mascot-auth">
          <%- include('partials/handshake') %>
        </div>
      </div>

      <div class="auth-card reveal reveal-2">
        <div class="auth-mark">🎓</div>
        <h2>Welcome Back!</h2>
        <p class="sub">Login to continue your journey 🚀</p>

        <% if (notice === 'not-configured') { %>
          <div class="notice warn">Google login isn't set up yet — add your Google API keys to <code>.env</code> to enable it.</div>
        <% } else if (notice === 'invalid') { %>
          <div class="notice warn">Incorrect email or password. Try again.</div>
        <% } else if (notice === 'success') { %>
          <div class="notice">Account created — log in below to continue.</div>
        <% } %>

        <a href="/auth/google" class="google-btn btn">
          <svg width="18" height="18" viewBox="0 0 18 18"><path fill="#4285F4" d="M17.64 9.2c0-.64-.06-1.25-.16-1.84H9v3.48h4.84c-.21 1.13-.84 2.09-1.8 2.73v2.27h2.91c1.7-1.57 2.69-3.88 2.69-6.64z"/><path fill="#34A853" d="M9 18c2.43 0 4.47-.8 5.96-2.18l-2.91-2.27c-.81.54-1.84.86-3.05.86-2.34 0-4.33-1.58-5.04-3.71H.96v2.34C2.44 15.98 5.48 18 9 18z"/><path fill="#FBBC05" d="M3.96 10.7A5.4 5.4 0 0 1 3.68 9c0-.59.1-1.17.28-1.7V4.96H.96A9 9 0 0 0 0 9c0 1.45.35 2.83.96 4.04l3-2.34z"/><path fill="#EA4335" d="M9 3.58c1.32 0 2.51.45 3.44 1.35l2.58-2.58C13.46.89 11.43 0 9 0 5.48 0 2.44 2.02.96 4.96l3 2.34C4.67 5.16 6.66 3.58 9 3.58z"/></svg>
          Continue with Google
        </a>
        <div class="divider">or login with email</div>

        <form action="/login" method="post">
          <div class="field">
            <span>✉️</span>
            <input type="text" name="email" placeholder="Email or Username" />
          </div>
          <div class="field" style="margin-top:12px;">
            <span>🔒</span>
            <input type="password" name="password" placeholder="Password" />
          </div>
          <div class="auth-row">
            <label><input type="checkbox" checked style="margin-right:6px;">Remember me</label>
            <a href="#">Forgot password?</a>
          </div>
          <button type="submit" class="btn btn-primary btn-block">→ Login</button>
        </form>

        <div class="auth-footer">Don't have an account? <a href="/signup">Sign Up →</a></div>
      </div>
    </div>
  </div>
  <script src="/js/main.js"></script>
</body>
</html>
