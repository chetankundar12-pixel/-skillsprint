<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Notes — SkillSprint</title>
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="/css/dashboard.css">
  <link rel="stylesheet" href="/css/upgrade.css">
</head>
<body>
  <div class="app-shell">
    <%- include('partials/sidebar', { active: 'notes', user }) %>

    <div class="main">
      <%- include('partials/topbar', { user }) %>

      <div class="dcontent">
        <div class="photo-banner reveal">
          <div class="banner-body">
            <h1>📝 <span class="name-accent">Notes & Resources</span></h1>
            <div class="banner-tagline"><span class="t1">Save, explore</span> <span class="t2">and study smarter.</span></div>
            <p class="banner-desc">Write it down right after class — future-you will thank you.</p>
          </div>
        </div>

        <div class="section-card">
          <div class="section-head">
            <h3>Study Library</h3>
          </div>
          <p class="hint-text">Syllabus, previous year papers and notes, sorted by semester.</p>

          <div class="pill-row" role="tablist" aria-label="Syllabus scheme">
            <% schemes.forEach(sc => { %>
              <a class="pill <%= sc === libScheme ? 'is-active' : '' %>" href="/notes?scheme=<%= encodeURIComponent(sc) %>&sem=<%= libSem %>"><%= sc %></a>
            <% }) %>
          </div>
          <div class="pill-row" aria-label="Semester">
            <% allSems.forEach(n => { %>
              <a class="pill <%= n === libSem ? 'is-active' : '' %>" href="/notes?scheme=<%= encodeURIComponent(libScheme) %>&sem=<%= n %>">Sem <%= n %></a>
            <% }) %>
          </div>

          <% if (library.length === 0) { %>
            <p class="hint-text">Nothing added for <%= libScheme %> · Sem <%= libSem %> yet. Check back soon.</p>
          <% } else { %>
            <% resTypes.forEach(t => { const group = library.filter(r => r.type === t); if (!group.length) return; %>
              <h4 class="lib-heading"><%= t === 'PYQ' ? 'Previous Year Papers' : t %></h4>
              <div class="lib-grid">
                <% group.forEach(r => { %>
                  <a class="lib-card" href="<%= r.url %>" target="_blank" rel="noopener noreferrer">
                    <span class="lib-type lib-<%= r.type.toLowerCase() %>"><%= r.type %></span>
                    <% if (r.ext) { %><span class="lib-ext"><%= r.ext %></span><% } %>
                    <b><%= r.title %></b>
                    <% if (r.subject) { %><span class="lib-sub"><%= r.subject %></span><% } %>
                    <span class="lib-open"><%= r.file && r.ext !== 'PDF' ? 'Download' : 'Open' %>
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 17 17 7"/><path d="M8 7h9v9"/></svg>
                    </span>
                  </a>
                <% }) %>
              </div>
            <% }) %>
          <% } %>
        </div>

        <div class="section-card">
          <div class="section-head">
            <h3>Write a new note</h3>
            <button class="focus-toggle">🎯 Focus</button>
          </div>
          <form method="post" action="/notes/add">
            <div style="display:grid; grid-template-columns:1fr 2fr; gap:14px; margin-bottom:14px;">
              <div class="field">
                <select name="subject" required>
                  <% mySubjects.forEach(s => { %><option value="<%= s %>"><%= s %></option><% }) %>
                  <option value="Other">Other</option>
                </select>
              </div>
              <div class="field"><input type="text" name="title" placeholder="Note title (e.g. Lecture 4 — Recursion)" required></div>
            </div>
            <textarea name="content" rows="5" placeholder="Write your lecture notes here..." required
              style="width:100%; background:#0c1024; border:1px solid var(--border); border-radius:12px; padding:14px; color:var(--text); font-family:inherit; font-size:.92rem; resize:vertical;"></textarea>
            <button type="submit" class="btn btn-primary" style="margin-top:14px;">→ Save Note</button>
          </form>
        </div>

        <div class="section-card">
          <div class="section-head">
            <h3>Your Notes (<%= notes.length %>)</h3>
            <button class="focus-toggle">🎯 Focus</button>
          </div>
          <% if (notes.length === 0) { %>
            <p class="hint-text">No notes yet — write your first one above.</p>
          <% } else { %>
            <div class="note-grid">
              <% notes.forEach(n => { %>
                <div class="note-card">
                  <div class="n-subject"><%= n.subject %></div>
                  <h4><%= n.title %></h4>
                  <p><%= n.content %></p>
                  <div class="n-foot">
                    <span><%= new Date(n.createdAt).toLocaleDateString() %></span>
                    <form method="post" action="/notes/delete">
                      <input type="hidden" name="noteId" value="<%= n.id %>">
                      <button class="n-del" type="submit">Delete</button>
                    </form>
                  </div>
                </div>
              <% }) %>
            </div>
          <% } %>
        </div>
      </div>
    </div>
  </div>
  <script src="/js/main.js"></script>
  <script src="/js/upgrade.js"></script>
  <script src="/js/focus.js"></script>
</body>
</html>
