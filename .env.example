# Copy this file to .env and fill in real values.

PORT=3000
SESSION_SECRET=change-this-to-something-random

# Get these from https://console.cloud.google.com/apis/credentials
# (Create OAuth client ID -> Web application -> Authorized redirect URI:
#  http://localhost:3000/auth/google/callback  for local dev, and your
#  real deployed URL + /auth/google/callback once you deploy)
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
