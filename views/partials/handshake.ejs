<svg class="mascot-img" viewBox="0 0 400 420" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="Chetan and Aaditya shaking hands" xmlns:c2pa="http://c2pa.org/manifest"><metadata><c2pa:manifest></c2pa:manifest></metadata>
  <defs>
    <linearGradient id="shirtA" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0%" stop-color="#8b5cf6"/>
      <stop offset="100%" stop-color="#3b82f6"/>
    </linearGradient>
    <linearGradient id="shirtB" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0%" stop-color="#3b82f6"/>
      <stop offset="100%" stop-color="#22d3ee"/>
    </linearGradient>
  </defs>

  <!-- ground shadow -->
  <ellipse cx="200" cy="404" rx="150" ry="12" fill="#000000" opacity="0.35"/>

  <!-- ===== CHETAN (left) ===== -->
  <g>
    <!-- back arm, relaxed -->
    <path d="M95 202 Q72 240 78 292" stroke="#12294f" stroke-width="19" stroke-linecap="round" fill="none"/>
    <!-- legs -->
    <rect x="94" y="288" width="27" height="92" rx="11" fill="#1e2a4a"/>
    <rect x="130" y="288" width="27" height="92" rx="11" fill="#28375f"/>
    <!-- shoes -->
    <rect x="86" y="372" width="42" height="15" rx="7" fill="#eef0fb"/>
    <rect x="124" y="372" width="42" height="15" rx="7" fill="#d9deef"/>
    <!-- torso / shirt -->
    <rect x="83" y="168" width="94" height="122" rx="24" fill="url(#shirtA)"/>
    <text x="130" y="236" text-anchor="middle" font-family="Arial, Helvetica, sans-serif" font-weight="800" font-size="15" fill="#ffffff" letter-spacing="1">CHETAN</text>
    <!-- front arm reaching to center -->
    <path d="M172 200 Q216 208 233 244" stroke="url(#shirtA)" stroke-width="21" stroke-linecap="round" fill="none"/>
    <!-- neck -->
    <rect x="117" y="148" width="26" height="26" rx="7" fill="#eab488"/>
    <!-- head -->
    <circle cx="130" cy="126" r="33" fill="#f0c39a"/>
    <!-- hair -->
    <path d="M96 118 Q98 86 130 84 Q162 86 164 118 Q150 96 130 98 Q110 96 96 118Z" fill="#2b1a12"/>
    <!-- face -->
    <circle cx="119" cy="128" r="3.2" fill="#2b1a12"/>
    <circle cx="141" cy="128" r="3.2" fill="#2b1a12"/>
    <path d="M117 141 Q130 150 143 141" stroke="#7a4a2a" stroke-width="2.6" fill="none" stroke-linecap="round"/>
  </g>

  <!-- ===== AADITYA (right, mirrored) ===== -->
  <g>
    <path d="M305 202 Q328 240 322 292" stroke="#3a2060" stroke-width="19" stroke-linecap="round" fill="none"/>
    <rect x="279" y="288" width="27" height="92" rx="11" fill="#1e2a4a"/>
    <rect x="243" y="288" width="27" height="92" rx="11" fill="#28375f"/>
    <rect x="272" y="372" width="42" height="15" rx="7" fill="#eef0fb"/>
    <rect x="234" y="372" width="42" height="15" rx="7" fill="#d9deef"/>
    <rect x="223" y="168" width="94" height="122" rx="24" fill="url(#shirtB)"/>
    <text x="270" y="236" text-anchor="middle" font-family="Arial, Helvetica, sans-serif" font-weight="800" font-size="13" fill="#ffffff" letter-spacing="1">AADITYA</text>
    <path d="M228 200 Q184 208 167 244" stroke="url(#shirtB)" stroke-width="21" stroke-linecap="round" fill="none"/>
    <rect x="257" y="148" width="26" height="26" rx="7" fill="#c98a5e"/>
    <circle cx="270" cy="126" r="33" fill="#d99a68"/>
    <path d="M238 120 Q242 86 270 84 Q298 86 302 120 Q288 98 270 100 Q252 98 238 120Z" fill="#1a1210"/>
    <circle cx="259" cy="128" r="3.2" fill="#1a1210"/>
    <circle cx="281" cy="128" r="3.2" fill="#1a1210"/>
    <path d="M257 141 Q270 150 283 141" stroke="#5a2f18" stroke-width="2.6" fill="none" stroke-linecap="round"/>
  </g>

  <!-- clasped hands -->
  <ellipse cx="200" cy="247" rx="21" ry="14" fill="#e5a878"/>
  <ellipse cx="200" cy="247" rx="21" ry="14" fill="#0000000d"/>

  <!-- motion sparks -->
  <g stroke="#22d3ee" stroke-width="2.4" stroke-linecap="round" opacity="0.85">
    <path d="M200 213 l0 -11"/>
    <path d="M176 223 l-9 -7"/>
    <path d="M224 223 l9 -7"/>
  </g>
</svg>
