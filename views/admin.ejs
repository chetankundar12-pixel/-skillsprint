<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Owner Panel — SkillSprint</title>
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="/css/dashboard.css">
  <link rel="stylesheet" href="/css/upgrade.css">
</head>
<body>
  <%
  var why = locals.why || '', added = locals.added || false, bad = locals.bad || false;
  var resources = locals.resources || [];
  var schemes = locals.schemes || ['NEP 2020', 'R-19'];
  var resTypes = locals.resTypes || ['Syllabus', 'PYQ', 'Notes'];
%>
  <div class="app-shell">
    <%- include('partials/sidebar', { active: 'admin', user }) %>
    <div class="main">
      <%- include('partials/topbar', { user }) %>
      <div class="dcontent">
        <div class="photo-banner reveal">
          <div class="banner-body">
            <h1><span class="name-accent">Owner Panel</span></h1>
            <p class="banner-desc">Send a notification. It shows up in the bell of every student it is meant for.</p>
          </div>
        </div>

        <div class="section-card">
          <div class="section-head"><h3>New notification</h3></div>
          <% if (sent) { %><div class="notice">Sent. Students will see it in their bell.</div><% } %>
          <form method="post" action="/admin/announce" class="admin-form">
            <div>
              <label class="field-label">Title</label>
              <div class="field"><input type="text" name="title" maxlength="80" placeholder="e.g. Unit test on Monday" required></div>
            </div>
            <div>
              <label class="field-label">Message (optional)</label>
              <div class="field"><input type="text" name="message" maxlength="400" placeholder="A short detail students should know"></div>
            </div>
            <div>
              <label class="field-label">Send to</label>
              <div class="field">
                <select name="audience" id="audSel">
                  <option value="all">All students</option>
                  <option value="year">One year only</option>
                </select>
              </div>
            </div>
            <div id="yearWrap" style="display:none;">
              <label class="field-label">Year</label>
              <div class="field">
                <select name="year"><% years.forEach(y => { %><option value="<%= y %>"><%= y %></option><% }) %></select>
              </div>
            </div>
            <button type="submit" class="btn btn-primary">Send notification</button>
          </form>
        </div>

        <div class="section-card" id="libraryCard">
          <div class="section-head"><h3>Add to Study Library</h3></div>
          <p class="hint-text">Upload everything in one go. Every file gets its own row where you can set scheme, semester and type.</p>
          <% if (added) { %><div class="notice">Added. Students will see it in Notes &amp; Resources.</div><% } %>
          <% if (bad) { %><div class="notice warn">Upload failed. <%= why || "Choose at least one file and a semester for each." %></div><% } %>
          <form method="post" action="/admin/resource" enctype="multipart/form-data" id="bulkForm">
            <div class="file-drop" id="dropZone">
              <label class="field-label" for="libFiles">Choose all your files at once</label>
              <input type="file" id="libFiles" name="files" multiple accept=".pdf,.doc,.docx,.ppt,.pptx,.xls,.xlsx,.txt,.zip,.jpg,.jpeg,.png">
              <span class="file-hint">Select as many as you like (up to 40, 25 MB each) or drag them here. Each file gets its own row below, already sorted using its file name (e.g. "sem3 pyq nep.pdf").</span>
            </div>

            <div id="bulkTools" class="bulk-tools" hidden>
              <b>Set for all files</b>
              <select id="allScheme"><option value="">Scheme</option><% schemes.forEach(sc => { %><option value="<%= sc %>"><%= sc %></option><% }) %></select>
              <select id="allSem"><option value="">Semester</option><% [1,2,3,4,5,6,7,8].forEach(n => { %><option value="<%= n %>">Sem <%= n %></option><% }) %></select>
              <select id="allType"><option value="">Type</option><% resTypes.forEach(t => { %><option value="<%= t %>"><%= t %></option><% }) %></select>
            </div>

            <div id="bulkRows" class="bulk-rows"></div>
            <button type="submit" class="btn btn-primary" id="bulkSubmit" hidden>Upload all files</button>
            <div id="uploadStatus" class="upload-status" role="status" aria-live="polite" hidden>
              <div class="upload-bar"><span id="uploadBar"></span></div>
              <p id="uploadMsg"></p>
            </div>
          </form>

          <% if (resources.length) { %>
            <ul class="admin-list" style="margin-top:18px;">
              <% resources.forEach(r => { %>
                <li>
                  <div>
                    <b><%= r.title %></b>
                    <em><%= r.scheme %> · Sem <%= r.sem %> · <%= r.type %><%= r.subject ? ' · ' + r.subject : '' %></em>
                    <span><a href="<%= r.url %>" target="_blank" rel="noopener noreferrer"><%= r.file ? 'View file' : 'Open link' %></a></span>
                  </div>
                  <form method="post" action="/admin/resource/delete">
                    <input type="hidden" name="resourceId" value="<%= r.id %>">
                    <button type="submit" class="btn btn-outline">Delete</button>
                  </form>
                </li>
              <% }) %>
            </ul>
          <% } %>
        </div>

        <div class="section-card">
          <div class="section-head"><h3>Sent notifications</h3></div>
          <% if (!announcements.length) { %>
            <p class="hint-text">Nothing sent yet.</p>
          <% } else { %>
            <ul class="admin-list">
              <% announcements.forEach(n => { %>
                <li>
                  <div>
                    <b><%= n.title %></b>
                    <% if (n.message) { %><span><%= n.message %></span><% } %>
                    <em><%= n.createdLabel %> · <%= n.audience === 'year' ? n.year : 'All students' %></em>
                  </div>
                  <form method="post" action="/admin/announce/delete">
                    <input type="hidden" name="announceId" value="<%= n.id %>">
                    <button type="submit" class="btn btn-outline">Delete</button>
                  </form>
                </li>
              <% }) %>
            </ul>
          <% } %>
        </div>
      </div>
    </div>
  </div>
  <script>
    (function () {
      var schemes = <%- JSON.stringify(schemes) %>, types = <%- JSON.stringify(resTypes) %>;
      var input = document.getElementById('libFiles'), rows = document.getElementById('bulkRows');
      var tools = document.getElementById('bulkTools'), submit = document.getElementById('bulkSubmit');
      var zone = document.getElementById('dropZone');
      if (!input) return;
      var files = [];

      function guess(name) {
        var n = name.toLowerCase().replace(/[_\-.]+/g, ' ');
        var sem = (n.match(/sem(?:ester)?\s*([1-8])/) || n.match(/\bs([1-8])\b/) || [])[1] || '1';
        var type = /pyq|paper|question|\bqp\b|previous/.test(n) ? 'PYQ' : (/syllabus|syll|curriculum/.test(n) ? 'Syllabus' : 'Notes');
        var scheme = /nep/.test(n) ? 'NEP 2020' : (/r\s*19|2019|\bold\b/.test(n) ? 'R-19' : schemes[0]);
        return { sem: sem, type: type, scheme: scheme };
      }
      function opt(list, val, fmt) {
        return list.map(function (v) { return '<option value="' + v + '"' + (String(v) === String(val) ? ' selected' : '') + '>' + (fmt ? fmt(v) : v) + '</option>'; }).join('');
      }
      function esc(t) { return String(t).replace(/[&<>"]/g, function (c) { return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]; }); }
      function sync() {
        var dt = new DataTransfer();
        files.forEach(function (f) { dt.items.add(f.file); });
        input.files = dt.files;
        tools.hidden = submit.hidden = !files.length;
        rows.innerHTML = '';
        files.forEach(function (f, i) {
          var g = f.g, row = document.createElement('div');
          row.className = 'bulk-row';
          row.innerHTML =
            '<div class="bulk-name"><b title="' + esc(f.file.name) + '">' + esc(f.file.name) + '</b><span>' + (f.file.size / 1048576).toFixed(1) + ' MB</span></div>' +
            '<select name="scheme" aria-label="Scheme">' + opt(schemes, g.scheme) + '</select>' +
            '<select name="sem" aria-label="Semester">' + opt([1,2,3,4,5,6,7,8], g.sem, function (v) { return 'Sem ' + v; }) + '</select>' +
            '<select name="type" aria-label="Type">' + opt(types, g.type) + '</select>' +
            '<input type="text" name="subject" placeholder="Subject (optional)" value="' + esc(g.subject || '') + '">' +
            '<input type="text" name="title" placeholder="Title (optional)" value="">' +
            '<button type="button" class="bulk-x" aria-label="Remove file" data-i="' + i + '">&times;</button>';
          rows.appendChild(row);
        });
      }
      function add(list) {
        Array.prototype.forEach.call(list, function (file) {
          if (files.some(function (f) { return f.file.name === file.name && f.file.size === file.size; })) return;
          if (files.length >= 40) return;
          files.push({ file: file, g: guess(file.name) });
        });
        sync();
      }
      input.addEventListener('change', function () { add(input.files); });
      rows.addEventListener('click', function (e) {
        var b = e.target.closest('.bulk-x'); if (!b) return;
        files.splice(Number(b.dataset.i), 1); sync();
      });
      ['allScheme', 'allSem', 'allType'].forEach(function (id) {
        var sel = document.getElementById(id);
        sel.addEventListener('change', function () {
          if (!sel.value) return;
          var name = id === 'allScheme' ? 'scheme' : (id === 'allSem' ? 'sem' : 'type');
          rows.querySelectorAll('select[name="' + name + '"]').forEach(function (s) { s.value = sel.value; });
          sel.value = '';
        });
      });
      ['dragenter', 'dragover'].forEach(function (ev) { zone.addEventListener(ev, function (e) { e.preventDefault(); zone.classList.add('is-drag'); }); });
      ['dragleave', 'drop'].forEach(function (ev) { zone.addEventListener(ev, function (e) { e.preventDefault(); zone.classList.remove('is-drag'); }); });
      zone.addEventListener('drop', function (e) { if (e.dataTransfer && e.dataTransfer.files.length) add(e.dataTransfer.files); });
      document.getElementById('bulkForm').addEventListener('submit', function (e) {
        e.preventDefault();
        if (!files.length) return;
        var status = document.getElementById('uploadStatus'), bar = document.getElementById('uploadBar'), msg = document.getElementById('uploadMsg');
        var setMsg = function (t, bad) { msg.textContent = t; msg.className = bad ? 'is-bad' : ''; };
        status.hidden = false; bar.style.width = '0%'; setMsg('Uploading ' + files.length + ' file(s)…');
        submit.disabled = true;
        var xhr = new XMLHttpRequest();
        xhr.open('POST', '/admin/resource');
        xhr.setRequestHeader('X-Requested-With', 'xhr');
        xhr.upload.onprogress = function (ev) {
          if (ev.lengthComputable) { var p = Math.round(ev.loaded / ev.total * 100); bar.style.width = p + '%'; setMsg('Uploading… ' + p + '%'); }
        };
        xhr.onload = function () {
          var data = {}; try { data = JSON.parse(xhr.responseText); } catch (err) {}
          if (xhr.status === 200 && data.ok) {
            bar.style.width = '100%'; setMsg('Done! ' + data.count + ' file(s) uploaded.');
            setTimeout(function () { location.href = '/admin?added=1#libraryCard'; }, 700);
          } else {
            submit.disabled = false;
            setMsg('Upload failed: ' + (data.why || xhr.responseText.slice(0, 200) || ('server said ' + xhr.status)), true);
          }
        };
        xhr.onerror = function () { submit.disabled = false; setMsg('Upload failed: could not reach the server. Is it still running?', true); };
        xhr.send(new FormData(e.target));
      });
    })();
  </script>
  <script>
    var aud = document.getElementById('audSel'), yw = document.getElementById('yearWrap');
    aud.addEventListener('change', function () { yw.style.display = aud.value === 'year' ? 'block' : 'none'; });
  </script>
  <script src="/js/main.js"></script>
  <script src="/js/upgrade.js"></script>
</body>
</html>
