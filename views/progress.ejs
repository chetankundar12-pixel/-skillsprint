<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Progress — SkillSprint</title>
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="/css/dashboard.css">
</head>
<body>
  <div class="app-shell">
    <%- include('partials/sidebar', { active: 'progress', user }) %>

    <div class="main">
      <%- include('partials/topbar', { user }) %>

      <div class="dcontent">
        <div class="photo-banner reveal">
          <%- include('partials/banner-photo', { user }) %>
          <div class="banner-body">
            <h1>📈 <span class="name-accent">Your Progress</span></h1>
            <div class="banner-tagline"><span class="t1">Everything you've</span> <span class="t2">tracked, in one view.</span></div>
            <p class="banner-desc">Attendance, CGPA, notes, and reminders — pulled together so you can see how the semester's actually going.</p>
          </div>
        </div>

        <div style="display:grid; grid-template-columns:repeat(4,1fr); gap:16px; margin-bottom:20px;">
          <div class="section-card" style="text-align:center; margin-bottom:0;">
            <% const aPct = overallAttendance.total === 0 ? 0 : overallAttendance.pct; const aCirc = 2*Math.PI*40; const aDash = (aPct/100)*aCirc; %>
            <div class="ring-wrap" style="width:100px; height:100px; margin:0 auto;">
              <svg viewBox="0 0 96 96">
                <circle cx="48" cy="48" r="40" fill="none" stroke="#232a4a" stroke-width="9"/>
                <circle cx="48" cy="48" r="40" fill="none" stroke="<%= aPct >= 75 ? '#22c55e' : '#ef4444' %>" stroke-width="9" stroke-linecap="round"
                  stroke-dasharray="<%= (aPct/100)*(2*Math.PI*40) %> <%= 2*Math.PI*40 %>"/>
              </svg>
              <div class="ring-label"><b style="font-size:1.1rem;"><%= overallAttendance.total === 0 ? '—' : aPct + '%' %></b></div>
            </div>
            <div class="hint-text" style="margin-top:10px; font-weight:700;">Attendance</div>
          </div>

          <div class="section-card" style="text-align:center; margin-bottom:0;">
            <% const cPct = Math.min(100, (overallCgpaVal/10)*100); %>
            <div class="ring-wrap" style="width:100px; height:100px; margin:0 auto;">
              <svg viewBox="0 0 96 96">
                <circle cx="48" cy="48" r="40" fill="none" stroke="#232a4a" stroke-width="9"/>
                <circle cx="48" cy="48" r="40" fill="none" stroke="#8b5cf6" stroke-width="9" stroke-linecap="round"
                  stroke-dasharray="<%= (cPct/100)*(2*Math.PI*40) %> <%= 2*Math.PI*40 %>"/>
              </svg>
              <div class="ring-label"><b style="font-size:1.1rem;"><%= overallCgpaVal || '—' %></b></div>
            </div>
            <div class="hint-text" style="margin-top:10px; font-weight:700;">CGPA</div>
          </div>

          <div class="section-card" style="text-align:center; margin-bottom:0;">
            <div class="ring-wrap" style="width:100px; height:100px; margin:0 auto;">
              <svg viewBox="0 0 96 96">
                <circle cx="48" cy="48" r="40" fill="none" stroke="#232a4a" stroke-width="9"/>
                <circle cx="48" cy="48" r="40" fill="none" stroke="#22d3ee" stroke-width="9" stroke-linecap="round"
                  stroke-dasharray="<%= (remindersOnTrack/100)*(2*Math.PI*40) %> <%= 2*Math.PI*40 %>"/>
              </svg>
              <div class="ring-label"><b style="font-size:1.1rem;"><%= remindersOnTrack %>%</b></div>
            </div>
            <div class="hint-text" style="margin-top:10px; font-weight:700;">Reminders Done</div>
          </div>

          <div class="section-card" style="text-align:center; margin-bottom:0; display:flex; flex-direction:column; justify-content:center;">
            <div style="font-size:2.2rem; font-weight:800;"><%= notesCount %></div>
            <div class="hint-text" style="font-weight:700;">Notes Saved</div>
          </div>
        </div>

        <div style="display:grid; grid-template-columns:1fr 1fr; gap:20px; align-items:start;">
          <div class="section-card">
            <div class="section-head">
              <h3>📅 Attendance by Subject</h3>
              <button class="focus-toggle">🎯 Focus</button>
            </div>
            <% if (subjectRows.length === 0) { %>
              <p class="hint-text">No attendance marked yet.</p>
            <% } else { %>
              <% subjectRows.forEach((r, i) => {
                const colors = ['#8b5cf6','#3b82f6','#22d3ee','#ec4899','#f59e0b','#22c55e'];
              %>
              <div class="subject-line">
                <span class="subject-dot" style="background:<%= colors[i % colors.length] %>;"></span>
                <span class="sname"><%= r.name %></span>
                <span class="spct"><%= r.total === 0 ? '—' : r.pct + '%' %></span>
              </div>
              <% }) %>
            <% } %>
          </div>

          <div class="section-card">
            <div class="section-head">
              <h3>🧮 SGPA Trend</h3>
              <button class="focus-toggle">🎯 Focus</button>
            </div>
            <% if (semTrend.length === 0) { %>
              <p class="hint-text">No semesters calculated yet — head to the CGPA Calculator.</p>
            <% } else { %>
              <div style="display:flex; align-items:flex-end; gap:14px; height:140px; padding-top:10px;">
                <% semTrend.forEach(s => { %>
                  <div style="flex:1; display:flex; flex-direction:column; align-items:center; gap:8px; height:100%; justify-content:flex-end;">
                    <div class="hint-text" style="font-weight:700; color:var(--text);"><%= s.sgpa %></div>
                    <div style="width:100%; max-width:34px; height:<%= Math.max(6, (s.sgpa/10)*100) %>%; background:var(--grad); border-radius:6px 6px 0 0;"></div>
                    <div class="hint-text">Sem <%= s.sem %></div>
                  </div>
                <% }) %>
              </div>
            <% } %>
          </div>
        </div>

        <div class="section-card">
          <div class="section-head">
            <h3>📝 Notes by Subject</h3>
            <button class="focus-toggle">🎯 Focus</button>
          </div>
          <% const subjEntries = Object.entries(notesBySubject); %>
          <% if (subjEntries.length === 0) { %>
            <p class="hint-text">No notes saved yet.</p>
          <% } else { %>
            <div class="quick-links" style="grid-template-columns:repeat(4,1fr);">
              <% subjEntries.forEach(([subject, count]) => { %>
                <div class="quick-link" style="cursor:default;">
                  <div class="ql-icon">📝</div>
                  <div class="ql-title"><%= subject %></div>
                  <div class="hint-text"><%= count %> note<%= count === 1 ? '' : 's' %></div>
                </div>
              <% }) %>
            </div>
          <% } %>
        </div>

        <div class="motivation-card">
          <div class="m-icon">💡</div>
          <h4>Discipline today</h4>
          <p>builds the freedom tomorrow.</p>
        </div>
      </div>
    </div>
  </div>
  <script src="/js/main.js"></script>
  <script src="/js/focus.js"></script>
</body>
</html>
