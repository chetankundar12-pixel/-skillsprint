<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title><%= title %> — SkillSprint</title>
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="/css/dashboard.css">
</head>
<body>
  <div class="app-shell">
    <%- include('partials/sidebar', { active: title.toLowerCase().includes('course') ? 'courses' : (title.toLowerCase().includes('study') ? 'study-plan' : 'progress'), user }) %>

    <div class="main">
      <%- include('partials/topbar', { user }) %>

      <div class="dcontent">
        <div class="section-card stub-card">
          <div class="stub-icon"><%= icon %></div>
          <h2><%= title %></h2>
          <p><%= text %></p>
        </div>
      </div>
    </div>
  </div>
</body>
</html>
