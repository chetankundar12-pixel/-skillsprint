<div class="topbar2">
  <button class="mobile-nav-toggle" type="button" aria-expanded="false" aria-controls="appSidebar" aria-label="Open menu">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><line x1="4" y1="7" x2="20" y2="7"/><line x1="4" y1="12" x2="20" y2="12"/><line x1="4" y1="17" x2="20" y2="17"/></svg>
  </button>
  <div class="topbar-search">
    🔍 <input type="text" placeholder="Search courses, topics, or resources...">
  </div>
  <div class="notif" id="notifWrap">
    <button type="button" class="notif-btn" id="notifBtn" aria-expanded="false" aria-haspopup="true" aria-controls="notifPanel" aria-label="Notifications">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 8a6 6 0 0 0-12 0c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.73 21a2 2 0 0 1-3.46 0"/></svg>
      <span class="notif-badge" id="notifBadge" hidden>0</span>
    </button>
    <div class="notif-panel" id="notifPanel" role="menu">
      <div class="notif-head"><strong>Notifications</strong><a href="/reminders">View all</a></div>
      <ul class="notif-list" id="notifList"><li class="notif-empty">Loading…</li></ul>
    </div>
  </div>
  <div class="topbar-user2" id="userMenuTrigger">
    <button type="button" class="user-menu-btn" aria-expanded="false" aria-haspopup="true" aria-controls="userMenu">
      <span class="avatar" aria-hidden="true"><%= (user.fullName || 'U').trim().charAt(0).toUpperCase() %></span>
      <span class="tu-name"><%= user.fullName ? user.fullName.split(' ')[0] : '' %></span> ▾
    </button>
    <div class="user-menu" id="userMenu">
      <a href="/profile"><svg class="menu-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg><span>Edit Profile</span></a>
      <% if (typeof isAdmin !== 'undefined' && isAdmin) { %>
      <a href="/admin"><svg class="menu-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg><span>Owner Panel</span></a>
      <% } %>
      <a href="/logout" class="menu-logout"><svg class="menu-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg><span>Logout</span></a>
    </div>
  </div>
</div>
